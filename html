        <!-- 1. ส่วนหัว (Profile Header) -->
        <header class="profile-header glass-card">

            <!-- ฉากป่ายามค่ำคืน (เบลอ อยู่เป็นพื้นหลังในกรอบการ์ดโปรไฟล์) -->
            <div class="card-scene" id="cardScene" aria-hidden="true">
                <div class="star-field" id="cardStars"></div>
                <div class="forest">
                    <div class="fx-layer fx-moon" data-depth="4">
                        <span class="moon-halo"></span>
                        <span class="moon-halo h2"></span>
                        <span class="moon-disc"></span>
                    </div>

                    <div class="fx-layer fx-mtn far" data-depth="8">
                        <svg viewBox="0 0 1440 400" preserveAspectRatio="none">
                            <path d="M0 400 L0 250 L120 190 L240 240 L380 140 L520 230 L650 170 L800 250 L940 120 L1080 220 L1220 170 L1340 230 L1440 190 L1440 400Z"/>
                        </svg>
                    </div>

                    <div class="fx-layer fx-fog f1" data-depth="10"><div class="fog-drift"></div></div>

                    <div class="fx-layer fx-mtn mid" data-depth="16">
